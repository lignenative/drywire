# The settings of one Drywire instance. Copy this file to
# deploy/instance.env (never committed: git ignores it) and fill it in.
# make deploy sends it to the host, where the server reads it. Every
# variable is described in server/README.md.
#
# Plain KEY=value lines: no quotes, no spaces around =, no ${...}.

# Where clients reach the control plane: the HTTPS origin your reverse
# proxy serves. Logins are signed for it and invitation links carry it.
# The web client is served at the same address (ADR 0049).
DRYWIRE_PUBLIC_URL=https://voice.example.org

# Where clients send audio: the host's public name and the relay port.
DRYWIRE_PUBLIC_RELAY=voice.example.org:30050

# Who may create spaces: device public keys, as `drywire identity`
# prints them, separated by commas. Empty: nobody (the server warns).
DRYWIRE_SPACE_CREATORS=

# The control plane, in plain HTTP on the host's loopback only: the
# reverse proxy on the same host serves it over TLS. (With a proxy in a
# Docker network, DRYWIRE_PROXY_NETWORK in .env, make deploy replaces this
# and DRYWIRE_TRUST_PROXY below.)
DRYWIRE_HTTP_ADDR=127.0.0.1:10050

# The relay, on every address of the host, IPv4 and IPv6. 30050 is
# Drywire's production port (ADR 0028); 10050 is the development one.
# Open this UDP port in the host's firewall and in the provider's, and
# keep DRYWIRE_PUBLIC_RELAY's port the same.
DRYWIRE_UDP_ADDR=:30050

# The relay's WebTransport side, for the web client (ADR 0038), on a UDP
# port of its own: 30058 in production, 10058 in development (ADR 0049).
# Open it like the relay's, and keep DRYWIRE_PUBLIC_WEB_RELAY's port the
# same. Browsers reach it at the public name, with the certificate the
# server makes and pins by its hash (ADR 0039): nothing to set up for TLS.
DRYWIRE_WEB_ADDR=:30058
DRYWIRE_PUBLIC_WEB_RELAY=voice.example.org:30058

# Where the reverse proxy connects from. Without it, every client would
# look like the proxy to the rate limits and the access log; with it, a
# request from the proxy names its client in the last X-Forwarded-For
# entry, which the proxy writes. 1: a proxy on this host (127.0.0.1).
# With DRYWIRE_PROXY_NETWORK, make deploy sets it to that network's subnet.
DRYWIRE_TRUST_PROXY=1

# Member limit of a new space (2 to 10000).
# DRYWIRE_MAX_MEMBERS=50

# Sign-in codes by e-mail (ADR 0055): a provider's SMTP submission port,
# always over TLS (465, or STARTTLS on 587). The provider sees each
# address and code it sends: list it as a sub-processor. Without these,
# the apps cannot sign in by e-mail on this instance. The hosted instance
# uses eusend (ADR 0056): user eusend, the live API key as password, and
# a sending address on the domain verified there.
# DRYWIRE_SMTP_ADDR=smtp.eusend.dev:465
# DRYWIRE_SMTP_USER=eusend
# DRYWIRE_SMTP_PASSWORD=eu_live_…
# DRYWIRE_MAIL_FROM=Drywire <no-reply@voice.example.org>
