# Copy this file to .env (never committed) and fill in what you need.
# The Makefile reads .env and passes every variable to the scripts.

# SSH alias of the server that runs the relay, as written in ~/.ssh/config.
# Used by the deploy commands; the repository never contains a host name.
HOST=

# If the host's reverse proxy runs in a Docker network that each project
# joins (a shared "edge" network), its name: make deploy then puts the
# server on that network instead of the host's (deploy/README.md, "A
# proxy in a Docker network"). Empty: a proxy on the host itself.
DRYWIRE_PROXY_NETWORK=

# A command on the host that publishes a reverse proxy route: it reads a
# Caddy site block on standard input. When set, make deploy sends it the
# instance's route; empty, you set the route up yourself.
ROUTE_PUBLISH_CMD=

# Backups (make backup, make restore) are encrypted with age
# (https://age-encryption.org), which you install. Make a key pair with
# `age-keygen -o ~/.config/drywire/backup-key.txt` and keep that file off
# the server, safe, and copied somewhere else: without it the backups are
# lost. BACKUP_RECIPIENTS are the public keys (age1...) backups are
# encrypted to, separated by spaces; BACKUP_IDENTITY is the private key
# file that decrypts them. See deploy/README.md, "Backups".
BACKUP_RECIPIENTS=
BACKUP_IDENTITY=

# Local listen addresses. The defaults below are the project's development
# ports; uncomment a line only to move a port for a while. The server never
# falls back to another port on its own: if the port is taken, it stops.
# DRYWIRE_HTTP_ADDR=127.0.0.1:10050
# DRYWIRE_UDP_ADDR=127.0.0.1:10050
