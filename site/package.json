{
  "name": "drywire-site",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 bun --bun astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 bun --bun astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 bun --bun astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 bun --bun astro check",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.2",
    "@types/bun": "1.4.4",
    "astro": "7.4.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "sharp": "file:./stubs/sharp"
  }
}
