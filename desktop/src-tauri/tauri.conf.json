{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drywire",
  "mainBinaryName": "drywire-desktop",
  "version": "0.1.0",
  "identifier": "com.lignenative.drywire",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:10051",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Drywire",
        "width": 380,
        "height": 640,
        "minWidth": 320,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Ligne Native",
    "copyright": "MIT License",
    "category": "SocialNetworking",
    "shortDescription": "Low-latency voice chat for teams who play together",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
